pipeline {
    agent any

    options {
        timestamps()
        disableConcurrentBuilds()
        timeout(time: 90, unit: 'MINUTES')
    }

    environment {
        SEO_SHARED_STATE_ROOT = '/var/lib/jenkins/shared/Seo_autotest/state'
    }

    parameters {
        choice(
            name: 'SITE',
            choices: ['all', '101', 'mol', 'pol'],
            description: 'Сайт для обновления baseline; all — последовательно все сайты'
        )
    }

    stages {
        stage('Collect baseline') {
            steps {
                sh '''
                    set -eu
                    rm -rf state
                    mkdir -p state
                    if [ "${SITE}" = "all" ]; then
                        for site in 101 mol pol; do
                            mkdir -p "${SEO_SHARED_STATE_ROOT}/${site}"
                            python3 -m taskdev_3188.cli --urls urls.txt --state-dir "${SEO_SHARED_STATE_ROOT}/${site}" --site "${site}" collect
                        done
                    else
                        mkdir -p "${SEO_SHARED_STATE_ROOT}/${SITE}"
                        python3 -m taskdev_3188.cli --urls urls.txt --state-dir "${SEO_SHARED_STATE_ROOT}/${SITE}" --site "${SITE}" collect
                    fi
                    cp -R "${SEO_SHARED_STATE_ROOT}/." state/
                '''
            }
        }
    }

    post {
        always {
            archiveArtifacts artifacts: 'state/*.json,state/**/*.json', allowEmptyArchive: true, fingerprint: true
        }
    }
}
