pipeline {
    agent any

    options {
        timestamps()
        disableConcurrentBuilds()
        timeout(time: 90, unit: 'MINUTES')
    }

    parameters {
        choice(
            name: 'SITE',
            choices: ['all', '101', 'mol', 'pol'],
            description: 'Сайт для обновления baseline; all — последовательно все сайты'
        )
    }

    stages {
        stage('Collect baseline') {
            steps {
                sh '''
                    set -eu
                    if [ "${SITE}" = "all" ]; then
                        for site in 101 mol pol; do
                            python3 -m taskdev_3188.cli --urls urls.txt --state-dir "state/${site}" --site "${site}" collect
                        done
                    else
                        python3 -m taskdev_3188.cli --urls urls.txt --state-dir "state/${SITE}" --site "${SITE}" collect
                    fi
                '''
            }
        }
    }

    post {
        always {
            archiveArtifacts artifacts: 'state/*.json,state/**/*.json', allowEmptyArchive: true, fingerprint: true
        }
    }
}
