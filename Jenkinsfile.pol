pipeline {
    agent any

    options {
        timestamps()
        disableConcurrentBuilds()
        timeout(time: 30, unit: 'MINUTES')
    }

    environment {
        TELEGRAM_ENABLED = 'true'
        TELEGRAM_PROXY_URL = credentials('telegram_proxy_url')
        TELEGRAM_PROXY_AUTH_SECRET = credentials('telegram_proxy_auth_secret')
        TELEGRAM_PROXY_CREDS = credentials('telegram_proxy_creds_seo')
        TELEGRAM_PROXY_TIMEOUT_SEC = '15'
        SEO_SITE_NAME = 'ПОЛ'
        SEO_SHARED_STATE_ROOT = '/var/lib/jenkins/shared/Seo_autotest/state'
    }

    triggers {
        cron('TZ=Europe/Moscow\n30 7 * * *')
    }

    stages {
        stage('Get baseline') {
            steps {
                sh '''
                    set -eu
                    rm -rf state/pol allure-results
                    mkdir -p state/pol
                    test -s "${SEO_SHARED_STATE_ROOT}/pol/approved_baseline.json"
                    cp -f "${SEO_SHARED_STATE_ROOT}/pol/approved_baseline.json" state/pol/approved_baseline.json
                '''
            }
        }

        stage('Validate ПОЛ') {
            steps {
                sh '''
                    set -eu
                    python3 -m taskdev_3188.cli --urls urls.txt --state-dir state/pol --site pol --allure-dir allure-results validate
                '''
            }
        }
    }

    post {
        always {
            archiveArtifacts artifacts: 'state/pol/*.json', allowEmptyArchive: true, fingerprint: true
            allure includeProperties: false, jdk: '', results: [[path: 'allure-results']]
        }
    }
}
